# Copy to .env (never commit .env). Each service reads only what it needs.
BASE_SEPOLIA_RPC=https://sepolia.base.org
ANVIL_RPC_URL=http://127.0.0.1:8545
DEPLOYER_PK=                 # contracts deploy (#5)
FACILITATOR_PK=              # facilitator hot wallet, pays gas (#8)
FACILITATOR_RATE_LIMIT=60
FACILITATOR_RATE_WINDOW_MS=60000
RELAY_RATE_LIMIT=60
RELAY_FAUCET_PER_DAY=1
# Comma-separated extras; wallet production and localhost are built in.
FACILITATOR_CORS_ORIGINS=
PAYMENT_RATE_LIMIT=120
TRUST_PROXY_HEADERS=0
FACILITATOR_URL=http://127.0.0.1:4022
SHADOWPASS_TOKEN=
MERCHANT_PAY_TO=
MAILBOX_KV_URL=              # mailbox storage (#9)
MAILBOX_KV_TOKEN=
MAILBOX_DB_PATH=.mailbox.sqlite
MAILBOX_PORT=8787
MAILBOX_HOST=127.0.0.1
MAILBOX_MAX_MESSAGE_BYTES=16384
MAILBOX_MAX_BATCH_SIZE=200
MAILBOX_MAX_PER_BOX=1000
MAILBOX_RETENTION_MS=2592000000
MAILBOX_RATE_LIMIT_POST=30
MAILBOX_RATE_LIMIT_GET=120
MAILBOX_RATE_WINDOW_MS=60000
MAILBOX_CORS_ORIGIN=*
MAILBOX_LOG_REQUESTS=0
MAILBOX_TRUSTED_PROXY_HEADER=

SHADOWPASS_NETWORK=anvil     # anvil | base-sepolia -> deployments/<network>.json
SHADOWPASS_ARTIFACTS=https://shadowpass-wallet.vercel.app/zk/circuits-v2   # or a local dir
SHADOWPASS_HOME=             # MCP agent data root; default ~/.shadowpass/agents
SHADOWPASS_AGENT_NAME=buyer  # MCP agent instance name
SHADOWPASS_RPC_URL=http://127.0.0.1:8545
SHADOWPASS_MAX_PAYMENT=10000000  # maximum single payment in token base units
SHADOWPASS_FACILITATOR=http://127.0.0.1:4022  # relay + x402 facilitator used by MCP treasury tools
VITE_FACILITATOR_URL=http://127.0.0.1:4022
VITE_SHADOWPASS_ARTIFACTS=https://shadowpass-wallet.vercel.app/zk/circuits-v2
