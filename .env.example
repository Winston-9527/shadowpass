# Copy to .env (never commit .env). Each service reads only what it needs.
BASE_SEPOLIA_RPC=https://sepolia.base.org
ANVIL_RPC_URL=http://127.0.0.1:8545
DEPLOYER_PK=                 # contracts deploy (#5)
FACILITATOR_PK=              # facilitator hot wallet, pays gas (#8)
FACILITATOR_RATE_LIMIT=60
FACILITATOR_RATE_WINDOW_MS=60000
MAILBOX_KV_URL=              # mailbox storage (#9)
MAILBOX_KV_TOKEN=
SHADOWPASS_NETWORK=anvil     # anvil | base-sepolia -> deployments/<network>.json
SHADOWPASS_ARTIFACTS=https://shadowpass-wallet.vercel.app/zk/circuits-v2   # or a local dir
SHADOWPASS_HOME=             # MCP agent data root; default ~/.shadowpass/agents
SHADOWPASS_AGENT_NAME=buyer  # MCP agent instance name
SHADOWPASS_RPC_URL=http://127.0.0.1:8545
SHADOWPASS_MAX_PAYMENT=10000000  # maximum single payment in token base units
