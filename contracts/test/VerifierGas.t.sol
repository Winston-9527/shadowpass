pragma solidity ^0.8.24;
import {Test, console2} from "forge-std/Test.sol";
import {ShadowVerifierD2} from "../src/ShadowVerifierD2.sol";
// Gas of the D = 2 Groth16 verifier on a real proof (circuits/scripts, seed gas-1). Calldata generated by snarkjs exportSolidityCallData.
contract VerifierGasTest is Test {
    function test_d2_verify_gas() public {
        ShadowVerifierD2 v = new ShadowVerifierD2();
        (uint[2] memory a, uint[2][2] memory b, uint[2] memory c, uint[16] memory p) = _cd();
        uint256 g = gasleft(); bool ok = v.verifyProof(a, b, c, p); g -= gasleft();
        assertTrue(ok); console2.log("ShadowVerifierD2.verifyProof gas", g);
        p[0] += 1; assertFalse(v.verifyProof(a, b, c, p));
    }
