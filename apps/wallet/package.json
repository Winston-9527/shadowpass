{
  "name": "@shadowpass/wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Owner wallet PWA, passkey + PRF (issues #10-#12)",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:mailbox": "node scripts/dev-mailbox.mjs",
    "build": "vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "node scripts/e2e.mjs",
    "e2e:chain": "node --import tsx scripts/chain-e2e.mts",
    "e2e:browser-chain": "node --import tsx scripts/browser-chain-e2e.mts"
  },
  "dependencies": {
    "@shadowpass/sdk": "*",
    "buffer": "6.0.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0"
  }
}
