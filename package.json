{
  "name": "shadowpass",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": [
    "circuits",
    "contracts",
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:chain": "bash scripts/dev-chain.sh",
    "claude:mvp": "bash scripts/mvp/claude.sh",
    "demo:mvp": "bash scripts/mvp/up.sh",
    "test:mvp": "bash scripts/mvp/e2e.sh",
    "test:mvp:agents": "node --test scripts/mvp/agents.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "libsodium-wrappers@0.7.15": {
      "libsodium": "0.7.15"
    }
  }
}
